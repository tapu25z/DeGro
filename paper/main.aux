\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main paired experiments on MIRA-Math (120 fixed pairs, 240 cases) and DRAW-Paired (350 pairs, 700 cases; 300 author-reviewed and 50 pending review). Values are percentages. FDA is primary; RSR and CAR decompose repair and abstention, and UR measures unsupported additions among proposed additions. Blue rows denote DeGro; bold FDA marks the best policy within each model and dataset. Only the MIRA GPT-OSS 20B comparison was preregistered; other comparisons are post-hoc. The cumulative DRAW-Paired estimate is provisional pending review of its extension.}}{7}{table.caption.17}\protected@file@percent }
\newlabel{tab:main}{{2}{7}{Main paired experiments on MIRA-Math (120 fixed pairs, 240 cases) and DRAW-Paired (350 pairs, 700 cases; 300 author-reviewed and 50 pending review). Values are percentages. FDA is primary; RSR and CAR decompose repair and abstention, and UR measures unsupported additions among proposed additions. Blue rows denote DeGro; bold FDA marks the best policy within each model and dataset. Only the MIRA GPT-OSS 20B comparison was preregistered; other comparisons are post-hoc. The cumulative DRAW-Paired estimate is provisional pending review of its extension}{table.caption.17}{}}
\newlabel{tab:draw_paired}{{2}{7}{Main paired experiments on MIRA-Math (120 fixed pairs, 240 cases) and DRAW-Paired (350 pairs, 700 cases; 300 author-reviewed and 50 pending review). Values are percentages. FDA is primary; RSR and CAR decompose repair and abstention, and UR measures unsupported additions among proposed additions. Blue rows denote DeGro; bold FDA marks the best policy within each model and dataset. Only the MIRA GPT-OSS 20B comparison was preregistered; other comparisons are post-hoc. The cumulative DRAW-Paired estimate is provisional pending review of its extension}{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces MIRA-Math comparison on the same fixed 120 pairs. DeGro has higher FDA than grounded self-review for all three models, while RSR and CAR expose model-specific tradeoffs. The GPT-OSS 20B comparison is preregistered; the GPT-OSS 120B and Nemotron Nano comparisons are post-hoc, and the Nano FDA difference is statistically inconclusive. All axes start at zero.}}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:result_summary}{{3}{7}{MIRA-Math comparison on the same fixed 120 pairs. DeGro has higher FDA than grounded self-review for all three models, while RSR and CAR expose model-specific tradeoffs. The GPT-OSS 20B comparison is preregistered; the GPT-OSS 120B and Nemotron Nano comparisons are post-hoc, and the Nano FDA difference is statistically inconclusive. All axes start at zero}{figure.caption.21}{}}
